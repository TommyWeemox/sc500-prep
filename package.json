{
  "name": "sc500-prep",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Site de préparation à la certification Microsoft SC-500, basé sur Microsoft Learn",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "content": "node scripts/build-content.mjs",
    "validate": "node scripts/validate-content.mjs",
    "links": "node scripts/check-links.mjs",
    "to-verify": "node scripts/to-verify.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run validate && npm run typecheck && vite build",
    "preview": "vite preview",
    "check": "npm run validate && npm run typecheck && npm test && vite build"
  },
  "dependencies": {
    "mermaid": "^12.1.0",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "jsdom": "^30.1.2",
    "marked": "^18.0.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
